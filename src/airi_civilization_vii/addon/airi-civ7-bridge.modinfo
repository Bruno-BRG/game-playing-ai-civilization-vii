<?xml version="1.0" encoding="utf-8"?>
<Mod id="airi-civ7-bridge" version="1" xmlns="ModInfo">
    <Properties>
        <Name>AIRI Civilization VII Bridge</Name>
        <Description>Exposes visible single-player state and validated actions to a local AI companion.</Description>
        <Authors>Project AIRI contributors</Authors>
        <ShowInBrowser>1</ShowInBrowser>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="Base Game" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet />
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="airi-civ7-bridge-game" scope="game" criteria="always">
            <Actions>
                <UIScripts>
                    <Item>ui/airi-bridge-config.js</Item>
                    <Item>ui/airi-bridge.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
    </ActionGroups>
</Mod>
