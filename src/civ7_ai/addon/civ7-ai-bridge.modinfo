<?xml version="1.0" encoding="utf-8"?>
<Mod id="civ7-ai-bridge" version="1" xmlns="ModInfo">
    <Properties>
        <Name>Civilization VII AI Bridge</Name>
        <Description>Exposes visible single-player state and validated actions to a local AI companion.</Description>
        <Authors>Bruno-BRG</Authors>
        <AffectsSavedGames>0</AffectsSavedGames>
        <ShowInBrowser>1</ShowInBrowser>
        <EnabledByDefault>1</EnabledByDefault>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="Base Game" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet />
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="civ7-ai-bridge-game" scope="game" criteria="always">
            <Actions>
                <UIScripts>
                    <Item>ui/civ7-ai-bridge-config.js</Item>
                    <Item>ui/civ7-ai-bridge.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
    </ActionGroups>
</Mod>
